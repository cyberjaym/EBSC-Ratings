# Copy to .env.local (gitignored) and fill in real values.

# Safe to expose to the browser — gated entirely by RLS, same key that ends
# up in client-side JS in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_, never
# commit, never send to the browser. Only needed by test/live-auth-isolation.test.mjs.
SUPABASE_SECRET_KEY=

# "yourapp.com" in production. For local dev, lvh.me resolves to 127.0.0.1,
# giving real wildcard-subdomain behavior (tenanta.lvh.me:3000) without
# owning a domain yet.
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000
